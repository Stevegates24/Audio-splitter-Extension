{
  "manifest_version": 3,
  "name": "Steve's Audio Mixer",
  "version": "4.0",
  "description": "Multi-output audio router with EQ, effects and presets for Chromebook",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "favicon.png", "48": "favicon.png", "128": "favicon.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "favicon.png", "48": "favicon.png", "128": "favicon.png" }
}
